{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "description": "Build for Windows x64 using the Visual Studio generator",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.22621",
      "warnings": {"dev": true, "deprecated": true},
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true
      }
    },
    {
      "name": "windows-x64-ninja",
      "displayName": "Windows x64 (Ninja, CLion)",
      "description": "Build for Windows x64 with Ninja; use this with the CLion MSVC toolchain",
      "inherits": ["windows-x64"],
      "binaryDir": "${sourceDir}/build_x64_ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64",
      "description": "Windows build for x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-ninja",
      "configurePreset": "windows-x64-ninja",
      "displayName": "Windows x64 (Ninja)",
      "description": "Windows Ninja build for x64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
